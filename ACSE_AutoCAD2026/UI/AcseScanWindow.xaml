<Window x:Class="ACSE.AutoCAD2026.UI.AcseScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACSE - Template Compliance Scanner"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <!-- Top command bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Text="Template:" Margin="0,0,8,0" FontWeight="Bold"/>
            <TextBox x:Name="TemplatePathTextBox" Width="450" Margin="0,0,8,0"
                     Text="C:\ACSE\config\Standards\FAA_002_acad.dwt"/>
            <Button x:Name="ScanButton" Content="Scan" Width="100" Margin="0,0,8,0" Click="ScanButton_Click" 
                    Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="ManageDimStylesButton" Content="📏 Dim Styles" Width="110" Margin="0,0,8,0" Click="ManageDimStyles_Click"
                    Background="#9C27B0" Foreground="White" FontWeight="Bold" 
                    ToolTip="Manage dimension styles"/>
            <Button x:Name="FixAllButton" Content="Fix All" Width="100" Margin="0,0,8,0" Click="FixAllButton_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="RescanButton" Content="Rescan" Width="90" Click="RescanButton_Click"/>
        </StackPanel>

        <!-- Summary -->
        <Border DockPanel.Dock="Top" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="0,0,0,10" Background="#F5F5F5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Drawing:" FontWeight="Bold"/>
                    <TextBlock x:Name="DrawingTextBlock" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Template Styles:" FontWeight="Bold"/>
                    <TextBlock x:Name="TemplateInfoTextBlock"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Violations:" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalsTextBlock"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Score:" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="ScoreTextBlock" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="ShowTextStyleCheckBox" Content="TextStyle" IsChecked="True" Margin="0,0,10,0" 
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="ShowDimStyleCheckBox" Content="DimStyle" IsChecked="True" Margin="0,0,10,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="ShowLayerCheckBox" Content="Layer" IsChecked="True" Margin="0,0,10,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="ShowLinetypeCheckBox" Content="Linetype" IsChecked="True" Margin="0,0,10,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock x:Name="FilterCountTextBlock" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="ViolationsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  MouseDoubleClick="ViolationsGrid_MouseDoubleClick"
                  AlternatingRowBackground="#F0F0F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="RuleId" Binding="{Binding RuleId}" Width="80"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="100"/>
                <DataGridTextColumn Header="Handle" Binding="{Binding EntityHandle}" Width="80"/>
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="140"/>
                <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="150"/>
                <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="150"/>
                <DataGridCheckBoxColumn Header="AutoFix" Binding="{Binding AutoFixable}" Width="60"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Select in AutoCAD" Width="130" Margin="0,0,8,0" Click="SelectInAcad_Click"/>
            <Button Content="Fix Selected" Width="110" Margin="0,0,8,0" Click="FixSelected_Click"
                    Background="#FF9800" Foreground="White"/>
            <Button Content="Close" Width="90" Click="Close_Click"/>
        </StackPanel>

    </DockPanel>
</Window>
