<Window x:Class="ACSE.AutoCAD2026.UI.StandardsControlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACSE Standards Tool - Compliance Manager"
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E88E5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Margin" Value="0,5,0,8"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header: Title + Load Standards + Scan Button -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,12"
                BorderBrush="#2196F3" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯 ACSE Standards Tool" 
                              FontSize="20" 
                              FontWeight="Bold" 
                              Foreground="#2196F3"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="StandardsPathTextBox" 
                              Text="(No standards loaded)" 
                              FontSize="12" 
                              Foreground="Gray" 
                              Margin="20,0,0,0"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="1" 
                       Content="📁 Load Standards" 
                       Width="160"
                       Click="LoadStandards_Click" 
                       Style="{StaticResource ActionButton}"/>

                <Button Grid.Column="2" 
                       Content="🔍 Scan Drawing" 
                       Width="160" 
                       Background="#4CAF50"
                       Foreground="White" 
                       Click="ScanDrawing_Click" 
                       Style="{StaticResource ActionButton}"/>
            </Grid>
        </Border>

        <!-- Main Content Area: 3-Panel Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>   <!-- Left: Summary -->
                <ColumnDefinition Width="*"/>     <!-- Center: Violations Grid -->
                <ColumnDefinition Width="300"/>   <!-- Right: Properties Editor -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Quick Status Summary -->
            <Border Grid.Column="0" 
                   Background="White" 
                   CornerRadius="6" 
                   Padding="12" 
                   Margin="0,0,8,0"
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 Compliance Status" 
                              Style="{StaticResource Header}" 
                              FontSize="16"/>

                    <Separator Margin="0,5,0,10"/>

                    <TextBlock x:Name="TotalViolationsText" 
                              Text="Total Violations: 0" 
                              Style="{StaticResource StatusText}"
                              FontWeight="Bold"
                              FontSize="14"/>

                    <TextBlock x:Name="TotalEntitiesText" 
                              Text="Total Entities: 0" 
                              Style="{StaticResource StatusText}"
                              Foreground="Gray"
                              Margin="5,2,5,10"/>

                    <TextBlock Text="Breakdown:" 
                              Style="{StaticResource SectionHeader}"/>

                    <TextBlock x:Name="DimViolationsText" 
                              Text="Dimension Issues: 0" 
                              Style="{StaticResource StatusText}"/>

                    <TextBlock x:Name="TextViolationsText" 
                              Text="Text Issues: 0" 
                              Style="{StaticResource StatusText}"/>

                    <TextBlock x:Name="LayerViolationsText" 
                              Text="Layer Issues: 0" 
                              Style="{StaticResource StatusText}"/>

                    <TextBlock x:Name="LinetypeViolationsText" 
                              Text="Linetype Issues: 0" 
                              Style="{StaticResource StatusText}"/>

                    <Separator Margin="0,15,0,10"/>

                    <TextBlock Text="Safety Ratings:" 
                              Style="{StaticResource SectionHeader}"/>

                    <TextBlock x:Name="SafeFixesText" 
                              Text="Safe: 0" 
                              Style="{StaticResource StatusText}"
                              Foreground="Green"/>

                    <TextBlock x:Name="RecommendedFixesText" 
                              Text="Recommended: 0" 
                              Style="{StaticResource StatusText}"
                              Foreground="Orange"/>

                    <TextBlock x:Name="ManualReviewText" 
                              Text="Manual Review: 0" 
                              Style="{StaticResource StatusText}"
                              Foreground="Red"/>

                    <Separator Margin="0,15,0,10"/>

                    <TextBlock Text="Selection:" 
                              Style="{StaticResource SectionHeader}"/>

                    <TextBlock x:Name="SelectedCountText" 
                              Text="Selected: 0" 
                              Style="{StaticResource StatusText}"
                              FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- CENTER PANEL: Violations DataGrid -->
            <Border Grid.Column="1" 
                   Background="White" 
                   CornerRadius="6" 
                   Padding="10" 
                   Margin="0,0,8,0"
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="📋 Detected Violations" 
                              Style="{StaticResource Header}" 
                              FontSize="16"/>

                    <!-- Filter and Action Bar -->
                    <Grid Grid.Row="1" Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="🔍 Filter:" 
                                      VerticalAlignment="Center" 
                                      Margin="0,0,8,0"
                                      FontWeight="SemiBold"/>
                            <TextBox x:Name="FilterTextBox" 
                                    Width="200" 
                                    Height="28"
                                    VerticalContentAlignment="Center"
                                    TextChanged="FilterTextBox_TextChanged"
                                    ToolTip="Filter violations by type, entity, layer, or message"/>
                            <Button Content="✖ Clear" 
                                   Height="28" 
                                   Padding="8,0"
                                   Margin="5,0,0,0"
                                   Click="ClearFilter_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="☑ Select All" 
                                   Height="28" 
                                   Padding="10,0"
                                   Margin="0,0,5,0"
                                   Click="SelectAll_Click"/>
                            <Button Content="☐ Deselect All" 
                                   Height="28" 
                                   Padding="10,0"
                                   Click="DeselectAll_Click"/>
                            <Button Content="📊 Export CSV" 
                                   Height="28" 
                                   Padding="10,0"
                                   Margin="5,0,0,0"
                                   Background="#4CAF50"
                                   Foreground="White"
                                   Click="ExportCSV_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="ScanProgressBar" 
                                Grid.Row="2"
                                Height="4" 
                                Margin="0,0,0,8"
                                IsIndeterminate="True"
                                Visibility="Collapsed"/>

                    <DataGrid x:Name="ViolationsDataGrid"
                             Grid.Row="3"
                             AutoGenerateColumns="False"
                             IsReadOnly="False"
                             SelectionMode="Extended"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#F9F9F9"
                             RowHeaderWidth="0"
                             SelectionChanged="ViolationsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Fix" 
                                                   Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                   Width="45"/>

                            <DataGridTextColumn Header="Type" 
                                              Binding="{Binding Type}" 
                                              Width="90"
                                              IsReadOnly="True"/>

                            <DataGridTextColumn Header="Entity" 
                                              Binding="{Binding EntityName}" 
                                              Width="100"
                                              IsReadOnly="True"/>

                            <DataGridTextColumn Header="Layer" 
                                              Binding="{Binding Layer}" 
                                              Width="90"
                                              IsReadOnly="True"/>

                            <DataGridTextColumn Header="Issue" 
                                              Binding="{Binding Message}" 
                                              Width="*"
                                              IsReadOnly="True"/>

                            <DataGridTextColumn Header="Confidence" 
                                              Binding="{Binding ConfidenceText}" 
                                              Width="85"
                                              IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Safety" 
                                              Binding="{Binding RecommendationText}" 
                                              Width="110"
                                              IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Current" 
                                              Binding="{Binding Actual}" 
                                              Width="100"
                                              IsReadOnly="True"/>

                            <DataGridTextColumn Header="Expected" 
                                              Binding="{Binding Expected}" 
                                              Width="100"
                                              IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Properties Editor -->
            <Border Grid.Column="2" 
                   Background="White" 
                   CornerRadius="6" 
                   Padding="12"
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="✏️ Edit Properties" 
                              Style="{StaticResource Header}" 
                              FontSize="16"/>

                    <Separator Margin="0,5,0,10"/>

                    <TextBlock Text="Layer:" 
                              Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="LayerComboBox" 
                             Height="32" 
                             IsEditable="False"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Color:" 
                              Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="ColorComboBox" 
                             Height="32"
                             IsEditable="False"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Linetype:" 
                              Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="LinetypeComboBox" 
                             Height="32"
                             IsEditable="False"
                             Margin="0,0,0,10"/>

                    <Separator Margin="0,5,0,10"/>

                    <TextBlock Text="Text Style:" 
                              Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="TextStyleComboBox" 
                             Height="32"
                             IsEditable="False"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Text Height:" 
                              Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="TextHeightBox" 
                            Height="32" 
                            Text="0.125"
                            Margin="0,0,0,10"/>

                    <CheckBox x:Name="AnnotativeCheckBox" 
                             Content="Make Annotative" 
                             Margin="0,5,0,15"
                             FontSize="12"/>

                    <Button Content="Apply to Selected" 
                           Height="40" 
                           Background="#4CAF50" 
                           Foreground="White"
                           FontWeight="Bold"
                           Click="ApplyPropertiesToSelected_Click" 
                           Style="{StaticResource ActionButton}"/>

                    <TextBlock x:Name="EditorHintText" 
                              Text="Select violations to edit properties" 
                              Foreground="Gray" 
                              FontSize="11" 
                              TextWrapping="Wrap"
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

            <!-- Bottom Action Bar -->
            <StackPanel Grid.Row="2" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       Margin="0,15,0,0">
                <Button Content="🛡️ Apply Safe Fixes Only" 
                       Width="200" 
                       Height="45" 
                       Background="#4CAF50"
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="14"
                       Click="ApplySafeFixes_Click" 
                       Style="{StaticResource ActionButton}"
                       ToolTip="Apply only fixes with 90%+ confidence (Safe recommendations)"/>

                <Button Content="⚡ Apply Recommended Fixes" 
                       Width="200" 
                       Height="45" 
                       Background="#FF9800"
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="14"
                       Click="ApplyRecommendedFixes_Click" 
                       Style="{StaticResource ActionButton}"
                       ToolTip="Apply Safe + Recommended fixes (excludes Manual Review)"/>

                <Button Content="🚀 Apply Selected Fixes" 
                       Width="180" 
                       Height="45" 
                       Background="#2196F3"
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="14"
                       Click="ApplySelected_Click" 
                       Style="{StaticResource ActionButton}"/>

                <Button Content="🔄 Rescan Drawing" 
                       Width="150" 
                       Height="45" 
                       Background="#9C27B0"
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="14"
                       Click="RefreshStatus_Click" 
                       Style="{StaticResource ActionButton}"/>

                <Button Content="Close" 
                       Width="100" 
                       Height="45" 
                       Background="#757575"
                       Foreground="White"
                       FontSize="14"
                       Margin="10,0,0,0"
                       Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Window>
